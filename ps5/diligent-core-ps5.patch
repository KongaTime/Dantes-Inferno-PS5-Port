+#if defined(__PROSPERO__)
+// PS5's title modules do not export glob or fnmatch. Diligent searches
+// within a directory using '*' and '?' in the final path component.
+static bool MatchFileName(std::string_view Pattern, std::string_view Name)
+{
+    if (!Name.empty() && Name.front() == '.' && (Pattern.empty() || Pattern.front() != '.'))
+        return false;
+
+    size_t PatternPos = 0;
+    size_t NamePos = 0;
+    size_t Star = std::string_view::npos;
+    size_t StarEnd = 0;
+    while (NamePos < Name.size())
+    {
+        if (PatternPos < Pattern.size() && Pattern[PatternPos] == '*')
+        {
+            Star = PatternPos++;
+            StarEnd = NamePos;
+        }
+        else if (PatternPos < Pattern.size() &&
+                 (Pattern[PatternPos] == '?' || Pattern[PatternPos] == Name[NamePos]))
+        {
+            ++PatternPos;
+            ++NamePos;
+        }
+        else if (Star != std::string_view::npos)
+        {
+            PatternPos = Star + 1;
+            NamePos = ++StarEnd;
+        }
+        else
+        {
+            return false;
+        }
+    }
+    return Pattern.find_first_not_of('*', PatternPos) == std::string_view::npos;
+}
+#endif
