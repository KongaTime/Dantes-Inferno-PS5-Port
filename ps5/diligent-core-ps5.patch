+#if defined(__PROSPERO__)
+template <typename T, typename Enumerate>
+static std::vector<T> EnumerateDisplayProperties(Enumerate Get)
+{
+    uint32_t Count = 0;
+    if (Get(&Count, nullptr) != VK_SUCCESS || Count == 0)
+        return {};
+    std::vector<T> Items(Count);
+    if (Get(&Count, Items.data()) != VK_SUCCESS)
+        return {};
+    Items.resize(Count);
+    return Items;
+}
+
+static VkResult CreateProsperoSurface(VkInstance Instance, VkPhysicalDevice PhysicalDevice, VkSurfaceKHR* Surface)
+{
+    if (!vkGetPhysicalDeviceDisplayPropertiesKHR || !vkGetPhysicalDeviceDisplayPlanePropertiesKHR ||
+        !vkGetDisplayPlaneSupportedDisplaysKHR || !vkGetDisplayModePropertiesKHR ||
+        !vkGetDisplayPlaneCapabilitiesKHR || !vkCreateDisplayPlaneSurfaceKHR)
+        return VK_ERROR_EXTENSION_NOT_PRESENT;
+
+    const auto Displays = EnumerateDisplayProperties<VkDisplayPropertiesKHR>(
+        [&](uint32_t* Count, VkDisplayPropertiesKHR* Values) {
+            return vkGetPhysicalDeviceDisplayPropertiesKHR(PhysicalDevice, Count, Values);
+        });
+    const auto Planes = EnumerateDisplayProperties<VkDisplayPlanePropertiesKHR>(
+        [&](uint32_t* Count, VkDisplayPlanePropertiesKHR* Values) {
+            return vkGetPhysicalDeviceDisplayPlanePropertiesKHR(PhysicalDevice, Count, Values);
+        });
+
+    for (const auto& Display : Displays)
+    {
+        if (!(Display.supportedTransforms & VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR))
+            continue;
+        const auto Modes = EnumerateDisplayProperties<VkDisplayModePropertiesKHR>(
+            [&](uint32_t* Count, VkDisplayModePropertiesKHR* Values) {
+                return vkGetDisplayModePropertiesKHR(PhysicalDevice, Display.display, Count, Values);
+            });
+        for (uint32_t PlaneIndex = 0; PlaneIndex < Planes.size(); ++PlaneIndex)
+        {
+            const auto& Plane = Planes[PlaneIndex];
+            if (Plane.currentDisplay && Plane.currentDisplay != Display.display)
+                continue;
+            const auto Supported = EnumerateDisplayProperties<VkDisplayKHR>(
+                [&](uint32_t* Count, VkDisplayKHR* Values) {
+                    return vkGetDisplayPlaneSupportedDisplaysKHR(PhysicalDevice, PlaneIndex, Count, Values);
+                });
+            if (std::find(Supported.begin(), Supported.end(), Display.display) == Supported.end())
+                continue;
+            for (const auto& Mode : Modes)
+            {
+                VkDisplayPlaneCapabilitiesKHR Caps{};
+                if (vkGetDisplayPlaneCapabilitiesKHR(PhysicalDevice, Mode.displayMode, PlaneIndex, &Caps) != VK_SUCCESS)
+                    continue;
+                const auto Extent = Mode.parameters.visibleRegion;
+                const auto Fits = [Extent](VkExtent2D Min, VkExtent2D Max) {
+                    return Extent.width >= Min.width && Extent.width <= Max.width &&
+                           Extent.height >= Min.height && Extent.height <= Max.height;
+                };
+                if (!Fits(Caps.minSrcExtent, Caps.maxSrcExtent) || !Fits(Caps.minDstExtent, Caps.maxDstExtent))
+                    continue;
+                if (Caps.minSrcPosition.x > 0 || Caps.minSrcPosition.y > 0 ||
+                    Caps.maxSrcPosition.x < 0 || Caps.maxSrcPosition.y < 0 ||
+                    Caps.minDstPosition.x > 0 || Caps.minDstPosition.y > 0 ||
+                    Caps.maxDstPosition.x < 0 || Caps.maxDstPosition.y < 0)
+                    continue;
+                VkDisplayPlaneAlphaFlagBitsKHR Alpha = VK_DISPLAY_PLANE_ALPHA_OPAQUE_BIT_KHR;
+                if (!(Caps.supportedAlpha & Alpha))
+                    Alpha = VK_DISPLAY_PLANE_ALPHA_GLOBAL_BIT_KHR;
+                if (!(Caps.supportedAlpha & Alpha))
+                    continue;
+
+                VkDisplaySurfaceCreateInfoKHR Info{};
+                Info.sType = VK_STRUCTURE_TYPE_DISPLAY_SURFACE_CREATE_INFO_KHR;
+                Info.displayMode = Mode.displayMode;
+                Info.planeIndex = PlaneIndex;
+                Info.planeStackIndex = Plane.currentStackIndex;
+                Info.transform = VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR;
+                Info.globalAlpha = 1.0f;
+                Info.alphaMode = Alpha;
+                Info.imageExtent = Extent;
+                if (vkCreateDisplayPlaneSurfaceKHR(Instance, &Info, nullptr, Surface) == VK_SUCCESS)
+                    return VK_SUCCESS;
+            }
+        }
+    }
+    return VK_ERROR_INITIALIZATION_FAILED;
+}
+#endif
